SERVICE_NAME=buildos-auth-service
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/buildos_auth

JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=buildos-auth-service
JWT_AUDIENCE=buildos-api

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_PARALLELISM=4

MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

INTERNAL_API_KEY=replace-with-a-strong-random-secret

PASSWORD_RESET_EXPIRE_MINUTES=30

USER_SERVICE_URL=http://127.0.0.1:8019
USER_SERVICE_API_KEY=replace-with-a-strong-random-secret
USER_SERVICE_ID=buildos-auth-service
USER_SERVICE_TIMEOUT=5.0
